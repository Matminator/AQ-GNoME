# Copy to app/.env (gitignored) and adjust. All settings are optional.

# Folder holding the DTU Data deposit files (the four screening CSV/h5 files,
# disorder_prob.csv, precomputed_HHI_scores.csv, ase_db_GNoME_pp_corr.db).
AQ_GNOME_DATA_DIR=../data

# Dataset variants (solid filter × functional) kept in RAM at once, ~1.8 GB each.
AQ_GNOME_MAX_VARIANTS=1

# ":80" = plain HTTP on the server's IP. A hostname enables automatic HTTPS, e.g.
# SITE_ADDRESS=aqgnome.example.org  or  SITE_ADDRESS=34.88.1.2.sslip.io
SITE_ADDRESS=:80
